{
  "name": "rimac-learning",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "tsx scripts/test.ts unit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "coverage": "tsx scripts/test.ts coverage",
    "integration": "tsx scripts/test.ts integration",
    "local:dynamo": "tsx scripts/local-dynamo.ts",
    "bundle": "tsx scripts/bundle.ts && tsx scripts/package-local.ts",
    "inspect:package": "tsx scripts/inspect-package.ts",
    "config:local": "tsx scripts/config-local.ts",
    "deploy": "pnpm bundle && pnpm config:local && serverless deploy --config serverless.generated.json",
    "api:url": "tsx scripts/api-url.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1144.0",
    "@jest/globals": "30.5.2",
    "@serverless/typescript": "4.30.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.0",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "jest": "30.5.2",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "serverless": "4.43.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.35.0",
    "@aws-sdk/client-dynamodb": "3.1144.0",
    "@aws-sdk/lib-dynamodb": "3.1144.0",
    "zod": "4.6.5"
  }
}
